# ===========================================
# HaberNexus - Environment Variables
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env

# -------------------------------------------
# Database (SQLite - Prisma)
# -------------------------------------------
DATABASE_URL="file:./data.db"

# -------------------------------------------
# Auth.js v5 Configuration
# -------------------------------------------
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Auth.js Trust Host (production için true yapın)
AUTH_TRUST_HOST=true

# Auth.js URL (production için domain adresinizi yazın)
# ÖNEMLİ: Bu değişken Google OAuth callback URL'i için gereklidir
AUTH_URL="https://your-domain.com"

# -------------------------------------------
# Google OAuth 2.0
# -------------------------------------------
# Google Cloud Console'dan alın: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -------------------------------------------
# Gemini AI API
# -------------------------------------------
# Google AI Studio'dan alın: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# -------------------------------------------
# Site Configuration
# -------------------------------------------
NEXT_PUBLIC_SITE_URL="https://habernexus.com"
NEXT_PUBLIC_SITE_NAME="HaberNexus"

# -------------------------------------------
# Node Environment
# -------------------------------------------
NODE_ENV="development"

# -------------------------------------------
# GitHub Integration (Sürüm Yönetimi için)
# -------------------------------------------
# GitHub Personal Access Token (PAT) - repo erişimi için
# https://github.com/settings/tokens adresinden oluşturun
GITHUB_PAT="ghp_your_github_personal_access_token"

# GitHub Repository bilgileri
GITHUB_REPO_OWNER="your-github-username"
GITHUB_REPO_NAME="your-repo-name"

# -------------------------------------------
# Webhook Server Configuration
# -------------------------------------------
# Webhook sunucusu portu
WEBHOOK_PORT=9000

# Webhook secret (GitHub webhook ayarlarında kullanılır)
# Generate: openssl rand -hex 32
WEBHOOK_SECRET="your-webhook-secret-here"

# Kurulum dizini (production için)
INSTALL_DIR="/var/www/habernexus"

# Log dizini
LOG_DIR="/var/log/habernexus"
