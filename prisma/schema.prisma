// Prisma Schema - HaberNexus Database
// This file defines the database schema for the entire application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User roles enum
enum Role {
  ADMIN
  AUTHOR
  USER
}

// Comment status enum
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Sentiment enum for article sentiment analysis
enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

// Prompt type enum for categorizing prompts
enum PromptType {
  CONTENT      // Article content generation
  IMAGE        // Image generation
  SENTIMENT    // Sentiment analysis
  CATEGORY     // Category determination
  SUMMARY      // Summary generation
}

// Notification type enum
enum NotificationType {
  FOLLOW           // Someone followed you
  COMMENT          // Someone commented on your article
  COMMENT_REPLY    // Someone replied to your comment
  COMMENT_LIKE     // Someone liked your comment
  ARTICLE_LIKE     // Someone liked your article
  ARTICLE_BOOKMARK // Someone bookmarked your article
  SYSTEM           // System notification
}

// User model - All users in the system (Auth.js compatible)
model User {
  id            String          @id @default(cuid())
  email         String          @unique
  emailVerified DateTime?       // Required for Auth.js
  name          String?
  image         String?         // Profile image URL
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Profile fields (Community features)
  username      String?         @unique // URL-friendly unique username
  bio           String?         // Short biography
  website       String?         // Personal website URL
  location      String?         // User's location
  coverImage    String?         // Profile cover image URL
  
  // Auth.js relations
  accounts      Account[]
  sessions      Session[]
  
  // App relations
  articles      Article[]       // Articles assigned to this user (if AUTHOR)
  authorProfile AuthorProfile?  // Author profile (if AUTHOR role)
  bookmarks     Bookmark[]      // User's bookmarked articles
  votes         ArticleVote[]   // User's votes on articles
  comments      Comment[]       // User's comments
  commentLikes  CommentLike[]   // User's likes on comments
  preferences   UserPreferences? // User's personalization preferences
  
  // Community relations
  followers     Follow[]        @relation("Following") // Users who follow this user
  following     Follow[]        @relation("Followers") // Users this user follows
  notifications Notification[]  @relation("NotificationOwner") // Notifications for this user
  actorNotifications Notification[] @relation("NotificationActor") // Notifications triggered by this user
  
  @@index([username])
}

// Auth.js Account model - OAuth accounts linked to users
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js Session model - User sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Auth.js VerificationToken model - Email verification tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// User preferences model - For personalized homepage
model UserPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  favoriteCategories String  // Comma-separated category slugs (e.g., "teknoloji,ekonomi,spor")
  excludedCategories String? // Categories to exclude from feed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Author profile - Extended information for AUTHOR role users
model AuthorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?  // Short biography
  interests String   // Comma-separated interests/categories (e.g., "Teknoloji,Ekonomi")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Follow model - User follow relationships
model Follow {
  id          String   @id @default(cuid())
  followerId  String   // The user who is following
  followingId String   // The user being followed
  createdAt   DateTime @default(now())
  
  // Relations
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Notification model - User notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String           // The user who receives the notification
  actorId   String?          // The user who triggered the notification (optional for system notifications)
  type      NotificationType // Type of notification
  message   String           // Notification message
  link      String?          // Link to the related content
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  
  // Relations
  user      User             @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// Article model - Published content
model Article {
  id              String    @id @default(cuid())
  title           String    // AI-generated title
  slug            String    @unique
  content         String    // AI-generated content (full article)
  excerpt         String?   // Short summary
  imageUrl        String    // AI-generated or downloaded image
  imageSource     String?   // "ai" | "rss" | "placeholder" - Source of the image
  videoUrl        String?   // Original news video (if available)
  category        String    // AI-determined category
  viewCount       Int       @default(0)
  sentiment       Sentiment? // AI-analyzed sentiment (POSITIVE, NEGATIVE, NEUTRAL)
  sentimentScore  Float?    // Sentiment confidence score (0-1)
  publishedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Content Engine v3 fields
  summaryCache    String?   // Cached AI-generated summary
  summaryCachedAt DateTime? // Summary cache timestamp
  sourceFeedId    String?   // Source RSS feed ID
  researchSources String?   // JSON: Research sources used for article
  
  // Breaking News fields (Added: January 2026)
  isBreakingNews     Boolean  @default(false) // Is this a breaking news article?
  breakingPriority   Int?     @default(0)     // 0=normal, 1=low priority, 2=medium, 3=high priority breaking news
  lastUpdatedAt      DateTime? // Last time this article was updated (for breaking news updates)
  updateCount        Int      @default(0)     // Number of times this breaking news article has been updated
  
  // Relations
  author      User          @relation(fields: [authorId], references: [id])
  authorId    String
  bookmarks   Bookmark[]    // Users who bookmarked this article
  votes       ArticleVote[] // Votes on this article
  comments    Comment[]     // Comments on this article
  
  @@index([category])
  @@index([publishedAt])
  @@index([viewCount])
  @@index([sentiment])
  @@index([authorId])
  @@index([sourceFeedId])
  @@index([isBreakingNews])
  @@index([breakingPriority])
}

// RSS Feed source model
model RssFeed {
  id           String   @id @default(cuid())
  url          String   @unique
  name         String   // Display name
  category     String   // Default category for articles from this feed
  isActive     Boolean  @default(true)
  topicsPerRun Int      @default(2)  // Number of articles to generate per run from this feed
  authorId     String?              // Assigned author for articles from this feed
  imageMode    String   @default("auto") // "rss" | "ai_original" | "ai_similar" | "auto"
  lastFetch    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([isActive])
  @@index([category])
}

// System settings model - For storing configuration
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "ai_model_content", "ai_model_image", "cron_schedule"
  value     String   // Setting value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Prompt template model - For managing AI prompts
model PromptTemplate {
  id          String     @id @default(cuid())
  name        String     @unique  // Unique identifier: "content_generation", "image_generation", etc.
  displayName String               // Human-readable name: "İçerik Üretim Promptu"
  description String?              // Description of what this prompt does
  type        PromptType           // Type of prompt (CONTENT, IMAGE, etc.)
  template    String               // The actual prompt template with {{variables}}
  variables   String               // JSON array of variable names: ["title", "content", "category"]
  isActive    Boolean    @default(true)
  isDefault   Boolean    @default(false) // Whether this is the default prompt for its type
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([type])
  @@index([isActive])
}

// Image settings model - For image optimization configuration
model ImageSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique // Setting key
  value                 String            // Setting value (JSON for complex settings)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Bookmark model - User's saved articles
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, articleId])
  @@index([userId])
}

// Article vote model - User votes (helpful/not helpful)
model ArticleVote {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  isHelpful Boolean  // true = helpful, false = not helpful
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, articleId])
  @@index([articleId])
}

// Newsletter subscription model
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([isActive])
}

// Comment model - User comments on articles
model Comment {
  id        String        @id @default(cuid())
  content   String        // Comment text
  status    CommentStatus @default(PENDING)
  articleId String
  userId    String
  parentId  String?       // For reply comments
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  // Relations
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  
  @@index([articleId])
  @@index([userId])
  @@index([status])
  @@index([parentId])
}

// Comment like model - User likes on comments
model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  @@unique([userId, commentId])
  @@index([commentId])
}


// Image error tracking model - For tracking failed image operations
model ImageError {
  id          String   @id @default(cuid())
  articleId   String?  // Optional: related article if applicable
  source      String   // "ai" | "rss" | "optimization"
  operation   String   // "download" | "generate" | "optimize" | "save"
  errorType   String   // Error classification (e.g., "timeout", "api_error", "invalid_format")
  errorMessage String  // Full error message
  sourceUrl   String?  // Original image URL if applicable
  category    String?  // Article category if applicable
  retryCount  Int      @default(0)
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  
  @@index([source])
  @@index([createdAt])
  @@index([resolved])
}

// Image statistics model - For tracking image generation/optimization stats
model ImageStats {
  id              String   @id @default(cuid())
  articleId       String?  // Optional: related article
  source          String   // "ai" | "rss"
  model           String?  // AI model used (for AI images)
  originalSize    Int?     // Original file size in bytes
  optimizedSize   Int?     // Optimized file size in bytes
  width           Int?     // Final image width
  height          Int?     // Final image height
  format          String?  // Output format (webp, jpeg, etc.)
  duration        Int      // Processing duration in milliseconds
  success         Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  @@index([source])
  @@index([createdAt])
  @@index([success])
}


// Contact message model - For storing contact form submissions
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   // genel, teknik, oneri, hata, isbirligi, diger
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([isRead])
  @@index([createdAt])
}


// Deployment settings model - For managing auto-deployment configuration
model DeploymentSettings {
  id                String   @id @default(cuid())
  key               String   @unique // Setting key (e.g., "webhook_enabled", "cooldown_period")
  value             String            // Setting value (JSON for complex settings)
  description       String?           // Description of the setting
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Deployment history model - For tracking deployment operations
model DeploymentHistory {
  id                String   @id @default(cuid())
  type              String   // "auto" | "manual" | "rollback"
  status            String   // "pending" | "running" | "success" | "failed"
  fromVersion       String?  // Previous version/commit
  toVersion         String   // Target version/commit
  triggeredBy       String?  // User who triggered (for manual deployments)
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  duration          Int?     // Duration in seconds
  logs              String?  // Deployment logs (JSON array)
  errorMessage      String?  // Error message if failed
  
  @@index([status])
  @@index([startedAt])
  @@index([type])
}


// Data transfer model - For managing data migration between instances
model DataTransfer {
  id          String   @id @default(cuid())
  code        String   @unique // Transfer code (UUID format)
  secretKey   String   // Encryption key hash for verification
  status      String   @default("pending") // "pending" | "ready" | "used" | "expired"
  fileName    String?  // Generated export file name
  fileSize    Int?     // File size in bytes
  tablesCount Int?     // Number of tables exported
  recordsCount Int?    // Total number of records exported
  expiresAt   DateTime // Expiration time (24 hours from creation)
  createdAt   DateTime @default(now())
  usedAt      DateTime? // When the transfer was imported
  createdBy   String   // Admin user ID who created the transfer
  usedBy      String?  // Admin user ID who imported the transfer
  
  @@index([code])
  @@index([status])
  @@index([expiresAt])
}


// Content Engine Run model - For tracking content generation runs
model ContentEngineRun {
  id              String   @id @default(cuid())
  status          String   @default("pending") // "pending" | "running" | "completed" | "failed"
  mode            String   @default("full")    // "full" | "preview"
  feedsProcessed  Int      @default(0)         // Number of feeds processed
  topicsFound     Int      @default(0)         // Number of topics found
  topicsSelected  Int      @default(0)         // Number of topics selected
  articlesCreated Int      @default(0)         // Number of articles created
  imagesGenerated Int      @default(0)         // Number of images generated
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  duration        Int?                         // Duration in seconds
  errorMessage    String?                      // Error message if failed
  logs            String?                      // JSON: Detailed logs
  triggeredBy     String?                      // User ID who triggered (for manual runs)
  
  @@index([status])
  @@index([startedAt])
}
